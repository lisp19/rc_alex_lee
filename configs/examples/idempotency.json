{
  "clients": {
    "idempotency-client": {"enabled": true, "targets": ["header-idempotency", "query-idempotency", "json-idempotency", "non-idempotent"], "manual_retry": true, "quota_policy": "default"}
  },
  "retry_policies": {
    "bounded": {"revision": 1, "delays": ["5s", "30s"], "max_duration": "10m", "respect_retry_after": true}
  },
  "quota_policies": {
    "default": {"ingress_global": 1000, "ingress_client": 100, "egress_target": 100, "egress_client_target": 50, "global_concurrency": 128, "target_concurrency": 8, "fail_mode": "open"}
  },
  "hooks": {},
  "issuers": {},
  "targets": {
    "header-idempotency": {
      "revision": 1, "enabled": true, "adapter": "generic_http",
      "endpoint": {"base_url": "http://mock-target:8080", "allowed_hosts": ["mock-target"], "allowed_methods": ["POST"], "allowed_path_prefixes": ["/a"], "allowed_cidrs": ["172.29.0.0/24"], "allow_http": true, "connect_timeout": "2s", "request_timeout": "10s", "max_response_bytes": 1048576},
      "auth": {"type": "none"},
      "idempotency": {"mode": "supported", "inject": [{"location": "header", "key": "Idempotency-Key"}]},
      "retry_enabled": true, "retry_policy": "bounded", "quota_policy": "default", "default_mode": "async", "allow_proxy": true, "preview_bytes": 8192
    },
    "query-idempotency": {
      "revision": 1, "enabled": true, "adapter": "generic_http",
      "endpoint": {"base_url": "http://mock-target:8080", "allowed_hosts": ["mock-target"], "allowed_methods": ["POST"], "allowed_path_prefixes": ["/a"], "allowed_cidrs": ["172.29.0.0/24"], "allow_http": true, "connect_timeout": "2s", "request_timeout": "10s", "max_response_bytes": 1048576},
      "auth": {"type": "none"},
      "idempotency": {"mode": "supported", "inject": [{"location": "query", "key": "partner_id"}]},
      "retry_enabled": true, "retry_policy": "bounded", "quota_policy": "default", "default_mode": "async", "allow_proxy": true, "preview_bytes": 8192
    },
    "json-idempotency": {
      "revision": 1, "enabled": true, "adapter": "generic_http",
      "endpoint": {"base_url": "http://mock-target:8080", "allowed_hosts": ["mock-target"], "allowed_methods": ["POST"], "allowed_path_prefixes": ["/b"], "allowed_cidrs": ["172.29.0.0/24"], "allow_http": true, "connect_timeout": "2s", "request_timeout": "10s", "max_response_bytes": 1048576},
      "auth": {"type": "none"},
      "idempotency": {"mode": "supported", "inject": [{"location": "body_json", "json_pointer": "/request_id"}]},
      "retry_enabled": true, "retry_policy": "bounded", "quota_policy": "default", "default_mode": "async", "allow_proxy": true, "preview_bytes": 8192
    },
    "non-idempotent": {
      "revision": 1, "enabled": true, "adapter": "generic_http",
      "endpoint": {"base_url": "http://mock-target:8080", "allowed_hosts": ["mock-target"], "allowed_methods": ["POST"], "allowed_path_prefixes": ["/c"], "allowed_cidrs": ["172.29.0.0/24"], "allow_http": true, "connect_timeout": "2s", "request_timeout": "10s", "max_response_bytes": 1048576},
      "auth": {"type": "none"},
      "idempotency": {"mode": "unsupported", "allow_uncertain_retry": false},
      "retry_enabled": true, "retry_policy": "bounded", "quota_policy": "default", "default_mode": "async", "allow_proxy": false, "preview_bytes": 8192
    }
  }
