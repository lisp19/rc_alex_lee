{
  "clients": {
    "partner-client": {"enabled": true, "targets": ["authenticated-http"], "manual_retry": false, "quota_policy": "default"}
  },
  "retry_policies": {
    "bounded": {"revision": 1, "delays": ["5s"], "max_duration": "10m", "respect_retry_after": true}
  },
  "quota_policies": {
    "default": {"ingress_global": 100, "ingress_client": 10, "egress_target": 10, "egress_client_target": 5, "global_concurrency": 16, "target_concurrency": 4, "fail_mode": "closed"}
  },
  "hooks": {},
  "issuers": {},
  "targets": {
    "authenticated-http": {
      "revision": 1, "enabled": true, "adapter": "generic_http",
      "endpoint": {"base_url": "https://api.example.com", "allowed_hosts": ["api.example.com"], "allowed_methods": ["POST"], "allowed_path_prefixes": ["/v1/events/"], "allowed_cidrs": [], "allow_http": false, "connect_timeout": "2s", "request_timeout": "10s", "max_response_bytes": 1048576},
      "auth": {"type": "static_header", "header": "Authorization", "secret_ref": "partner-token"},
      "idempotency": {"mode": "unknown", "allow_uncertain_retry": false},
      "retry_enabled": false, "retry_policy": "bounded", "quota_policy": "default", "default_mode": "async", "allow_proxy": false, "preview_bytes": 8192, "sensitive_json_fields": ["password", "email"]
    }
  }
