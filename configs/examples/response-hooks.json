{
  "clients": {
    "hook-client": {"enabled": true, "targets": ["business-response", "report-response"], "manual_retry": true, "quota_policy": "default"}
  },
  "retry_policies": {
    "bounded": {"revision": 1, "delays": ["5s", "30s"], "max_duration": "10m", "respect_retry_after": true}
  },
  "quota_policies": {
    "default": {"ingress_global": 1000, "ingress_client": 100, "egress_target": 100, "egress_client_target": 50, "global_concurrency": 128, "target_concurrency": 8, "fail_mode": "open"}
  },
  "hooks": {
    "business-code": {"revision": 1, "expression": "{'action': json.code == 0 ? 'success' : (json.code == 1001 ? 'retry' : 'fail'), 'reason': 'vendor_business_code', 'report': {'vendor_code': json.code}}"},
    "report-only": {"revision": 1, "expression": "{'action': 'report', 'report': {'vendor_code': json.code, 'http_status': status, 'attempt_no': attempt}}"}
  },
  "issuers": {},
  "targets": {
    "business-response": {
      "revision": 1, "enabled": true, "adapter": "generic_http",
      "endpoint": {"base_url": "http://mock-target:8080", "allowed_hosts": ["mock-target"], "allowed_methods": ["POST"], "allowed_path_prefixes": ["/b"], "allowed_cidrs": ["172.29.0.0/24"], "allow_http": true, "connect_timeout": "2s", "request_timeout": "10s", "max_response_bytes": 1048576},
      "auth": {"type": "none"}, "idempotency": {"mode": "supported", "inject": [{"location": "header", "key": "Idempotency-Key"}]},
      "retry_enabled": true, "retry_policy": "bounded", "hook": "business-code", "quota_policy": "default", "default_mode": "async", "allow_proxy": true, "preview_bytes": 8192, "sensitive_json_fields": ["password", "email"]
    },
    "report-response": {
      "revision": 1, "enabled": true, "adapter": "generic_http",
      "endpoint": {"base_url": "http://mock-target:8080", "allowed_hosts": ["mock-target"], "allowed_methods": ["POST"], "allowed_path_prefixes": ["/b"], "allowed_cidrs": ["172.29.0.0/24"], "allow_http": true, "connect_timeout": "2s", "request_timeout": "10s", "max_response_bytes": 1048576},
      "auth": {"type": "none"}, "idempotency": {"mode": "supported", "inject": [{"location": "header", "key": "Idempotency-Key"}]},
      "retry_enabled": true, "retry_policy": "bounded", "hook": "report-only", "quota_policy": "default", "default_mode": "async", "allow_proxy": true, "preview_bytes": 8192, "sensitive_json_fields": ["password", "email"]
    }
  }
}
